#!/bin/bash
# config-hash: ${config_hash}   (changes when any config in S3 changes => new server)
set -euo pipefail   # monitoring IS this server's job: fail loudly (and no -x: secret below)

PROM_VER="${prometheus_version}"
AM_VER="${alertmanager_version}"
BB_VER="${blackbox_version}"

# Download a Prometheus-project release, verify its SHA-256, extract it
gh_install() {
  local proj=$1 ver=$2
  local base="https://github.com/prometheus/$proj/releases/download/v$ver"
  local opts="--retry 10 --retry-delay 15 --retry-all-errors --connect-timeout 10"
  curl -fsSLO $opts "$base/$proj-$ver.linux-amd64.tar.gz"
  curl -fsSL  $opts -o "$proj-sha256sums.txt" "$base/sha256sums.txt"
  sha256sum -c --ignore-missing "$proj-sha256sums.txt"
  tar xzf "$proj-$ver.linux-amd64.tar.gz"
  rm -f "$proj-$ver.linux-amd64.tar.gz"
}

WORKDIR=/var/tmp/monitoring-install
mkdir -p "$WORKDIR"
cd "$WORKDIR"
gh_install prometheus "$PROM_VER"
install -m 0755 prometheus-$PROM_VER.linux-amd64/{prometheus,promtool} /usr/local/bin/
gh_install alertmanager "$AM_VER"
install -m 0755 alertmanager-$AM_VER.linux-amd64/{alertmanager,amtool} /usr/local/bin/
gh_install blackbox_exporter "$BB_VER"
install -m 0755 blackbox_exporter-$BB_VER.linux-amd64/blackbox_exporter /usr/local/bin/

# ---- Users and directories ----
for u in prometheus alertmanager blackbox_exporter; do useradd -r -M -s /sbin/nologin "$u"; done
mkdir -p /etc/prometheus/rules /etc/blackbox_exporter /var/lib/prometheus /var/lib/alertmanager
chown prometheus:prometheus /var/lib/prometheus
chown alertmanager:alertmanager /var/lib/alertmanager
install -d -o root -g alertmanager -m 0750 /etc/alertmanager

# ---- Slack webhook: fetched at boot, readable only by alertmanager, never in user data ----
(umask 027; aws ssm get-parameter --region ${region} --name "/${name}/monitoring/slack_webhook" \
   --with-decryption --query Parameter.Value --output text | tr -d '\n' > /etc/alertmanager/slack_webhook)
chown root:alertmanager /etc/alertmanager/slack_webhook
grep -q '^https://hooks.slack.com/services/' /etc/alertmanager/slack_webhook \
  || { echo "ERROR: Slack webhook in Parameter Store is malformed" >&2; exit 1; }

# ---- Configuration from S3 (via the free S3 gateway endpoint, not the NAT) ----
CFG="s3://${config_bucket}/monitoring"
aws s3 cp --recursive --region ${region} "$CFG/prometheus/"   /etc/prometheus/
aws s3 cp --recursive --region ${region} "$CFG/alertmanager/" /etc/alertmanager/
aws s3 cp --recursive --region ${region} "$CFG/blackbox/"     /etc/blackbox_exporter/

# ---- Validate what was downloaded: fail loudly on a bad upload ----
promtool check config /etc/prometheus/prometheus.yml   # also validates the rule file
chown root:alertmanager /etc/alertmanager/alertmanager.yml
chmod 640 /etc/alertmanager/alertmanager.yml
amtool check-config /etc/alertmanager/alertmanager.yml

# ---- systemd services (all bound to localhost) ----
cat > /etc/systemd/system/blackbox_exporter.service <<'EOF'
[Unit]
Description=Prometheus Blackbox Exporter
After=network-online.target
Wants=network-online.target

[Service]
User=blackbox_exporter
Group=blackbox_exporter
ExecStart=/usr/local/bin/blackbox_exporter \
  --config.file=/etc/blackbox_exporter/blackbox.yml \
  --web.listen-address=127.0.0.1:9115
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/alertmanager.service <<'EOF'
[Unit]
Description=Prometheus Alertmanager
After=network-online.target
Wants=network-online.target

[Service]
User=alertmanager
Group=alertmanager
ExecStart=/usr/local/bin/alertmanager \
  --config.file=/etc/alertmanager/alertmanager.yml \
  --storage.path=/var/lib/alertmanager \
  --web.listen-address=127.0.0.1:9093 \
  --cluster.listen-address=
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/alertmanager

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/prometheus.service <<'EOF'
[Unit]
Description=Prometheus
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/usr/local/bin/prometheus \
  --config.file=/etc/prometheus/prometheus.yml \
  --storage.tsdb.path=/var/lib/prometheus \
  --storage.tsdb.retention.time=7d \
  --web.listen-address=127.0.0.1:9090
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus

[Install]
WantedBy=multi-user.target
EOF

# ---- Grafana: pinned RPM, checksum pinned in Terraform, localhost only ----
GF_RPM="grafana-${grafana_version}-1.x86_64.rpm"
curl -fsSLO --retry 10 --retry-delay 15 --retry-all-errors --connect-timeout 10 \
  "https://dl.grafana.com/oss/release/$GF_RPM"
echo "${grafana_rpm_sha256}  $GF_RPM" | sha256sum -c -     # must match the value in Git
dnf install -y "./$GF_RPM"
rm -f "$GF_RPM"

# Our config AFTER the RPM, so ours wins (the RPM ships its own grafana.ini)
aws s3 cp --recursive --region ${region} "$CFG/grafana/" /etc/grafana/

# Admin password: fetched at boot, readable only by the grafana group
(umask 027; aws ssm get-parameter --region ${region} --name "/${name}/monitoring/grafana_admin_password" \
   --with-decryption --query Parameter.Value --output text | tr -d '\n' > /etc/grafana/admin_password)
chown root:grafana /etc/grafana/admin_password /etc/grafana/grafana.ini
chmod 640 /etc/grafana/admin_password /etc/grafana/grafana.ini

# Dashboards (JSON from S3), loaded by the provisioning file above
mkdir -p /var/lib/grafana/dashboards
aws s3 cp --recursive --region ${region} "$CFG/dashboards/" /var/lib/grafana/dashboards/
chown -R grafana:grafana /var/lib/grafana/dashboards

systemctl daemon-reload
systemctl enable --now blackbox_exporter alertmanager prometheus grafana-server
cd / && rm -rf "$WORKDIR"  