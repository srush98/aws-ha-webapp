groups:
  - name: tf-webapp
    rules:
      - alert: InstanceDown
        expr: up{job="node"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "App instance {{ $labels.instance }} is down"
          description: "node_exporter on {{ $labels.instance }} ({{ $labels.az }}) has not answered for 1 minute."

      - alert: HighCpu
        expr: 100 * (1 - avg by (instance, az) (rate(node_cpu_seconds_total{mode="idle"}[5m]))) > ${cpu_threshold}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High CPU on {{ $labels.instance }}"
          description: "CPU is {{ $value | humanize }}% (threshold ${cpu_threshold}%) for 5 minutes."

      - alert: DiskSpaceHigh
        expr: 100 * (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > ${disk_threshold}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Root disk filling up on {{ $labels.instance }}"
          description: "{{ $value | humanize }}% used (threshold ${disk_threshold}%)."

      - alert: SslCertExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry{job="blackbox_https"} - time()) / 86400 < ${ssl_days}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate for {{ $labels.instance }} expires soon"
          description: "{{ $value | humanize }} days left (threshold ${ssl_days}). ACM should auto-renew: check its status."

      # Companion to the SSL alert: if the probe fails, the expiry metric disappears
      - alert: EndpointDown
        expr: probe_success{job="blackbox_https"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} is unreachable"
          description: "The HTTPS probe has failed for 2 minutes (DNS, TLS, ALB or app)."