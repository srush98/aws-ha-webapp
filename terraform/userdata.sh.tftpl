#!/bin/bash
set -euo pipefail   # no -x: the DB password must never reach the logs

dnf install -y java-17-amazon-corretto-devel git mariadb105 tar

# Tomcat 9 (pinned), running as an unprivileged user
useradd -r -M -d /opt/tomcat -s /sbin/nologin tomcat
mkdir -p /opt/tomcat
curl -fsSL https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.98/bin/apache-tomcat-9.0.98.tar.gz | tar xz -C /opt/tomcat --strip-components=1
rm -rf /opt/tomcat/webapps/*

# Build the WAR from the repository
curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz | tar xz -C /opt
git clone ${repo_url} /tmp/app
cd /tmp/app && /opt/apache-maven-3.9.9/bin/mvn -q -B package
cp target/LoginWebApp.war /opt/tomcat/webapps/ROOT.war
chown -R tomcat:tomcat /opt/tomcat

# Database settings from Parameter Store (secret fetched at boot, never in user data)
get() { aws ssm get-parameter --region ${region} --name "$1" --with-decryption --query Parameter.Value --output text; }
DB_URL=$(get /${prefix}/db/url)
DB_USER=$(get /${prefix}/db/user)
DB_PASSWORD=$(get /${prefix}/db/password)

cat > /etc/tomcat-db.env <<EOF
DB_URL=$DB_URL
DB_USER=$DB_USER
DB_PASSWORD=$DB_PASSWORD
EOF
chown root:tomcat /etc/tomcat-db.env && chmod 640 /etc/tomcat-db.env

# Create the schema if missing (idempotent); never block Tomcat if this fails
MYSQL_PWD="$DB_PASSWORD" mysql -h ${db_host} -u "$DB_USER" --ssl jwt < /tmp/app/db/schema.sql \
  || echo "WARNING: schema step failed"

# Tomcat as a systemd service
cat > /etc/systemd/system/tomcat.service <<'EOF'
[Unit]
Description=Apache Tomcat 9
After=network.target
[Service]
Type=forking
User=tomcat
Group=tomcat
EnvironmentFile=/etc/tomcat-db.env
Environment=CATALINA_PID=/opt/tomcat/temp/tomcat.pid
PIDFile=/opt/tomcat/temp/tomcat.pid
ExecStart=/opt/tomcat/bin/startup.sh
ExecStop=/opt/tomcat/bin/shutdown.sh
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now tomcat

# ---- Ship Tomcat logs to S3 every 5 minutes, and once more at shutdown ----
cat > /usr/local/bin/ship-tomcat-logs.sh <<'EOF'
#!/bin/bash
set -euo pipefail
BUCKET="${log_bucket}"
TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
ID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
aws s3 sync /opt/tomcat/logs "s3://$BUCKET/tomcat/$ID/" --region ${region} --only-show-errors
EOF
chmod 750 /usr/local/bin/ship-tomcat-logs.sh

cat > /etc/systemd/system/tomcat-logs.service <<'EOF'
[Unit]
Description=Ship Tomcat logs to S3
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ship-tomcat-logs.sh
EOF

cat > /etc/systemd/system/tomcat-logs.timer <<'EOF'
[Unit]
Description=Ship Tomcat logs to S3 every 5 minutes
[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Persistent=true
[Install]
WantedBy=timers.target
EOF

cat > /etc/systemd/system/tomcat-logs-final.service <<'EOF'
[Unit]
Description=Final Tomcat log upload at shutdown
After=network-online.target
Wants=network-online.target
Before=tomcat.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/ship-tomcat-logs.sh
[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now tomcat-logs.timer tomcat-logs-final.service

# ---- Prometheus node_exporter: host metrics on :9100. Must never block the app. ----
NE_VER="${node_exporter_version}"
NE_URL="https://github.com/prometheus/node_exporter/releases/download/v$NE_VER"

# Every step chained with && because bash ignores `set -e` inside `func || ...`
install_node_exporter() {
  cd /tmp &&
  curl -fsSLO "$NE_URL/node_exporter-$NE_VER.linux-amd64.tar.gz" &&
  curl -fsSL -o ne-sha256sums.txt "$NE_URL/sha256sums.txt" &&
  sha256sum -c --ignore-missing ne-sha256sums.txt &&
  tar xzf "node_exporter-$NE_VER.linux-amd64.tar.gz" &&
  install -m 0755 "node_exporter-$NE_VER.linux-amd64/node_exporter" /usr/local/bin/node_exporter &&
  useradd -r -M -s /sbin/nologin node_exporter
}

cat > /etc/systemd/system/node_exporter.service <<'EOF'
[Unit]
Description=Prometheus Node Exporter
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter --web.listen-address=:9100
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
EOF

install_node_exporter && systemctl daemon-reload && systemctl enable --now node_exporter \
  || echo "WARNING: node_exporter install failed; Prometheus will show this target as down"